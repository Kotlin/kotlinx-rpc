{
  "mcpServers": {
    "gradle": {
      "command": "jbang",
      "args": [
        "run",
        "--quiet",
        "--fresh",
        "gradle-mcp@rnett"
      ]
    },
    "develocity": {
      "type": "http",
      "url": "https://develocity.jetbrains.com/mcp",
      "headers": {
        "Authorization": "Bearer ${DEVELOCITY_TOKEN}"
      }
    }
  }
}
