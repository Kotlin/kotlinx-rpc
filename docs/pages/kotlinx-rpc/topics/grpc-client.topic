<!DOCTYPE topic
        SYSTEM "https://resources.jetbrains.com/writerside/1.0/xhtml-entities.dtd">
<topic xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="https://resources.jetbrains.com/writerside/1.0/topic.v2.xsd"
       title="Client" id="grpc-client">

    <p>
        <code>GrpcClient</code> connects to a gRPC server and provides service stubs via <code>withService</code>.
    </p>
    <code-block lang="Kotlin">
        import kotlinx.io.bytestring.ByteString
        import kotlinx.rpc.grpc.client.GrpcClient
        import kotlinx.rpc.withService
        import ImageRecognizer
        import invoke

        val client = GrpcClient("localhost", 8080) {
            credentials = plaintext()
        }

        val recognizer = client.withService&lt;ImageRecognizer&gt;()

        val image = Image {
            data = ByteString(0, 1, 2, 3)
        }
        val result = recognizer.recognize(image)
    </code-block>

    <chapter title="Configuration" id="grpc-client-configuration">
        <deflist>
            <def title="credentials">
                Sets client credentials. Use <code>plaintext()</code> for insecure connections (testing only)
                or <code>tls { ... }</code> for secure communication.
                Default TLS credentials are used when not specified.
            </def>
            <def title="messageMarshallerResolver">
                A <code>GrpcMarshallerResolver</code> for custom serialization.
                Not needed when using generated Protobuf types.
                See <a href="grpc-services.topic" anchor="no-proto"/>.
            </def>
            <def title="overrideAuthority">
                Overrides the authority used with TLS and HTTP virtual hosting.
                Does not change the actual host the client connects to.
            </def>
            <def title="intercept(...)">
                Adds client-side interceptors.
                Interceptors are executed in the order they are added.
            </def>
            <def title="userAgent">
                <p>
                    Sets an application user-agent prefix. The header has the form
                    <code>&lt;userAgent&gt; &lt;backend-user-agent&gt;</code>, with the backend portion formatted as follows:
                </p>
                <list>
                    <li>
                        JVM and Android (gRPC Java): <code>grpc-java-&lt;transport&gt;/&lt;grpc-java-version&gt;</code>,
                        where the transport is, for example, <code>netty</code> or <code>okhttp</code>.
                    </li>
                    <li>
                        Non-iOS Native (gRPC Core):
                        <code>grpc-c/&lt;grpc-core-version&gt; (&lt;platform&gt;; &lt;transport&gt;)</code>,
                        where the platform is, for example, <code>osx</code> or <code>linux</code>,
                        and the HTTP/2 transport is <code>chttp2</code>.
                    </li>
                    <li>
                        iOS (grpc-swift): <code>kotlinx-rpc-swift/&lt;kotlinx-rpc-version&gt;</code>.
                    </li>
                </list>
                <p>
                    If unset, only the backend's user-agent is sent.
                    Set this property instead of adding <code>user-agent</code> to call metadata.
                </p>
            </def>
            <def title="keepAlive { ... }">
                Configures keep-alive pings to detect broken connections.
                Disabled by default.
            </def>
        </deflist>
    </chapter>

    <chapter title="Lifecycle" id="grpc-client-lifecycle">
        <p>
            Call <code>shutdown()</code> to stop accepting new calls and <code>awaitTermination()</code>
            to wait for in-flight calls to complete.
            Use <code>shutdownNow()</code> to cancel all calls immediately.
        </p>
    </chapter>
</topic>
